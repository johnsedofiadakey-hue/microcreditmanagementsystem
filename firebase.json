{
  "functions": [
    {
      "source": "functions",
      "codebase": "core",
      "runtime": "nodejs22",
      "ignore": ["node_modules", "src", "test", "*.log", "vitest*.ts", "tsup.config.ts"],
      "predeploy": ["corepack pnpm --filter @susu/functions build"]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "auth": { "port": 9099 },
    "functions": { "port": 5001 },
    "firestore": { "port": 8080 },
    "storage": { "port": 9199 },
    "ui": { "enabled": true, "port": 4000 },
    "singleProjectMode": true
  }
}
