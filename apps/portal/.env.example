# Copy to .env.local. In development the portal talks to the Firebase Emulator Suite.
NEXT_PUBLIC_USE_EMULATORS=true
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-susu
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-susu.firebaseapp.com
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-susu.appspot.com
NEXT_PUBLIC_FUNCTIONS_REGION=europe-west1
# reCAPTCHA Enterprise site key for App Check. Leave empty against the emulators.
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=
