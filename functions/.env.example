# Copy to functions/.env.local for the emulator. Region for every function (BUILD_PLAN §4).
FUNCTIONS_REGION=europe-west1
# SMS: log (default, sends nothing) or arkesel. See src/runtime.ts.
SMS_PROVIDER=log
SMS_SENDER_ID=Susu
SMS_BRAND=Susu
# Set explicitly so the emulator never stops to prompt for them.
ENFORCE_APP_CHECK=true
CLOUD_SQL_INSTANCE=
